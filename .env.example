# Local access is the default. Shopify credentials are entered per browser session.
HOST=127.0.0.1
PORT=3000
SHOPIFY_API_VERSION=2026-10
DATABASE_PATH=./shopify_sync.db

# For remote hosting behind an HTTPS reverse proxy, set all three:
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://sync.example.com
# APP_PASSWORD=replace-with-a-long-unique-password
# Never put a Shopify token in this file.
